
import streamlit as st
import streamlit.components.v1 as components
import json

st.set_page_config(
    page_title="Mini Battle Arena",
    page_icon="⚔️",
    layout="wide"
)

CHARACTERS = {
    "전사": {
        "hp": 350,
        "damage": 35,
        "skill_damage": 90,
        "speed": 4.5,
        "color": "#e99b48",
        "weapon": "대검",
        "skill": "회전 베기",
        "description": "강력한 대검으로 적을 베어버린다."
    },
    "마법사": {
        "hp": 240,
        "damage": 25,
        "skill_damage": 110,
        "speed": 4,
        "color": "#a67aff",
        "weapon": "마법 지팡이",
        "skill": "메테오",
        "description": "마법을 발사하고 운석을 소환한다."
    },
    "궁수": {
        "hp": 280,
        "damage": 30,
        "skill_damage": 100,
        "speed": 5.5,
        "color": "#48ce9c",
        "weapon": "장궁",
        "skill": "연속 화살",
        "description": "빠른 화살 공격으로 적을 제압한다."
    }
}

st.markdown("""
<style>
.stApp {
    background: #101321;
    color: white;
}
h1,h2,h3 {
    color: #f2d38c !important;
}
div[data-testid="stSelectbox"] {
    max-width: 300px;
}
</style>
""", unsafe_allow_html=True)

st.markdown("""
<div style="text-align:center">
<h1>⚔ MINI BATTLE ARENA ⚔</h1>
<p style="color:#aaa;letter-spacing:4px">
REAL TIME SIDE SCROLLING ACTION
</p>
</div>
""", unsafe_allow_html=True)

st.divider()

col1, col2 = st.columns([1, 2])

with col1:
    st.subheader("🛡️ 영웅 선택")

    character = st.selectbox(
        "플레이할 캐릭터",
        list(CHARACTERS.keys())
    )

    c = CHARACTERS[character]

    st.markdown(f"### {character}")
    st.write(f"⚔️ 무기: {c['weapon']}")
    st.write(f"✨ 스킬: {c['skill']}")
    st.write(c["description"])

    st.metric("최대 체력", c["hp"])
    st.metric("공격력", c["damage"])
    st.metric("이동 속도", c["speed"])

with col2:
    st.subheader("🎮 전투 조작")

    st.markdown("""
    | 키 | 행동 |
    |---|---|
    | A / D | 좌우 이동 |
    | ← / → | 좌우 이동 |
    | W / ↑ | 점프 |
    | J | 무기 공격 |
    | K | 특수 스킬 |
    """)

st.divider()

# 게임 데이터 전달
game_data = {
    "name": character,
    **c
}

# HTML 게임
html = r"""
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #101321;
    font-family: Arial, sans-serif;
    color: white;
    overflow: hidden;
}

#game {
    width: 100%;
    background: #14182b;
    border: 2px solid #656080;
    border-radius: 12px;
    display: block;
    outline: none;
}

.controls {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
}

button {
    background: #34334d;
    color: white;
    border: 1px solid #77708f;
    border-radius: 10px;
    padding: 13px 20px;
    font-weight: bold;
    font-size: 15px;
    cursor: pointer;
    touch-action: none;
}

button:active {
    background: #9272cf;
    transform: scale(.96);
}

#message {
    text-align: center;
    color: #f5d58c;
    font-size: 18px;
    font-weight: bold;
    margin: 12px;
}
</style>
</head>

<body>

<canvas id="game" width="1000" height="520" tabindex="0"></canvas>

<div id="message">전투 준비 완료!</div>

<div class="controls">
    <button id="left">◀ 이동</button>
    <button id="right">이동 ▶</button>
    <button id="jump">⬆ 점프</button>
    <button id="attack">⚔ 공격 (J)</button>
    <button id="skill">✨ 스킬 (K)</button>
    <button id="restart">🔄 다시 시작</button>
</div>

<script>
const CONFIG = __CONFIG__;

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");
const message = document.getElementById("message");

const W = canvas.width;
const H = canvas.height;
const GROUND = 425;

let keys = {};
let player;
let enemy;
let projectiles = [];
let effects = [];
let particles = [];
let camera = 0;
let gameOver = false;
let result = "";
let lastTime = 0;
let attackPressed = false;
let skillPressed = false;
let shake = 0;
let frame = 0;

function resetGame() {
    player = {
        x: 130,
        y: GROUND - 76,
        w: 46,
        h: 76,
        hp: CONFIG.hp,
        maxHp: CONFIG.hp,
        vx: 0,
        vy: 0,
        grounded: true,
        facing: 1,
        speed: CONFIG.speed,
        attackCooldown: 0,
        skillCooldown: 0,
        invincible: 0,
        attackAnim: 0,
        skillAnim: 0
    };

    enemy = {
        x: 720,
        y: GROUND - 85,
        w: 60,
        h: 85,
        hp: 500,
        maxHp: 500,
        speed: 1.5,
        attackCooldown: 0,
        invincible: 0
    };

    projectiles = [];
    effects = [];
    particles = [];
    camera = 0;
    gameOver = false;
    result = "";
    message.innerText = "전투 시작! 적을 처치하라!";
}

function text(str, x, y, size=20, color="white") {
    ctx.fillStyle = color;
    ctx.font = `bold ${size}px Arial`;
    ctx.fillText(str, x, y);
}

function bar(x, y, w, h, value, max, color) {
    ctx.fillStyle = "#24283c";
    ctx.fillRect(x, y, w, h);

    ctx.fillStyle = color;
    ctx.fillRect(x, y, w * Math.max(0, value/max), h);

    ctx.strokeStyle = "#ffffff";
    ctx.strokeRect(x, y, w, h);
}

function drawBackground() {
    let gradient = ctx.createLinearGradient(0,0,0,H);
    gradient.addColorStop(0,"#151c39");
    gradient.addColorStop(1,"#30304a");

    ctx.fillStyle = gradient;
    ctx.fillRect(0,0,W,H);

    // 별
    for(let i=0;i<55;i++) {
        let x = (i*193 - camera*.2) % W;
        if(x<0) x+=W;

        ctx.fillStyle = "#d9dfff";
        ctx.globalAlpha = .35 + Math.sin(frame*.03+i)*.2;
        ctx.fillRect(x,(i*79)%260,2,2);
    }

    ctx.globalAlpha = 1;

    // 배경 건물
    for(let i=0;i<9;i++) {
        let x = ((i*180-camera*.35)%1200);
        if(x< -100) x+=1200;

        ctx.fillStyle = "#222940";
        ctx.fillRect(x,270,100,155);

        ctx.fillStyle = "#424563";
        ctx.fillRect(x+15,290,15,25);
        ctx.fillRect(x+55,290,15,25);
    }

    // 바닥
    ctx.fillStyle = "#292a3d";
    ctx.fillRect(0,GROUND,W,H-GROUND);

    ctx.fillStyle = "#72708c";
    ctx.fillRect(0,GROUND,W,5);

    for(let i=0;i<30;i++) {
        let x=(i*70-camera)%W;
        if(x<0)x+=W;
        ctx.fillStyle="#45465d";
        ctx.fillRect(x,450,35,4);
    }
}

function drawPlayer() {
    const x = player.x-camera;
    const y = player.y;

    ctx.save();

    if(player.invincible>0 && frame%6<3) {
        ctx.globalAlpha=.4;
    }

    // 그림자
    ctx.fillStyle="#090b16";
    ctx.beginPath();
    ctx.ellipse(x+23,GROUND-3,30,7,0,0,Math.PI*2);
    ctx.fill();

    // 몸
    ctx.fillStyle=CONFIG.color;
    ctx.fillRect(x+8,y+27,30,37);

    // 머리
    ctx.fillStyle="#edc49c";
    ctx.fillRect(x+10,y+3,27,26);

    // 머리카락
    ctx.fillStyle="#30253a";
    ctx.fillRect(x+8,y,30,10);

    // 눈
    ctx.fillStyle="#252030";
    ctx.fillRect(
        player.facing===1?x+29:x+13,
        y+15,4,4
    );

    // 다리
    ctx.fillStyle="#353b55";
    ctx.fillRect(x+10,y+62,10,14);
    ctx.fillRect(x+27,y+62,10,14);

    // 무기
    drawWeapon(x,y);

    ctx.restore();
}

function drawWeapon(x,y) {
    ctx.save();

    if(CONFIG.name==="전사") {
        ctx.translate(x+23,y+42);
        ctx.rotate(player.facing===1?-.7:.7);

        ctx.fillStyle="#aeb9cf";
        ctx.fillRect(13,-35,9,62);

        ctx.fillStyle="#e5c16d";
        ctx.fillRect(2,10,30,7);
    }

    else if(CONFIG.name==="마법사") {
        ctx.fillStyle="#8a633e";
        ctx.fillRect(
            player.facing===1?x+37:x-5,
            y+20,5,47
        );

        ctx.fillStyle="#c8a2ff";
        ctx.beginPath();
        ctx.arc(
            player.facing===1?x+39:x-3,
            y+18,10,0,Math.PI*2
        );
        ctx.fill();
    }

    else {
        ctx.strokeStyle="#d4a36a";
        ctx.lineWidth=5;
        ctx.beginPath();

        let wx=player.facing===1?x+43:x+3;
        ctx.arc(wx,y+38,18,
            player.facing===1?-.9:2.2,
            player.facing===1?.9:4.1
        );
        ctx.stroke();
    }

    ctx.restore();
}

function drawEnemy() {
    let x=enemy.x-camera;
    let y=enemy.y;

    ctx.fillStyle="#0c0b18";
    ctx.beginPath();
    ctx.ellipse(x+30,GROUND-3,35,8,0,0,Math.PI*2);
    ctx.fill();

    ctx.fillStyle="#8f426e";
    ctx.fillRect(x+5,y+25,50,55);

    ctx.fillStyle="#c4a0a0";
    ctx.fillRect(x+8,y,44,33);

    // 뿔
    ctx.fillStyle="#e5d5cf";
    ctx.beginPath();
    ctx.moveTo(x+10,y+7);
    ctx.lineTo(x-4,y-13);
    ctx.lineTo(x+22,y+9);
    ctx.fill();

    ctx.beginPath();
    ctx.moveTo(x+42,y+7);
    ctx.lineTo(x+60,y-13);
    ctx.lineTo(x+31,y+9);
    ctx.fill();

    // 눈
    ctx.fillStyle="#ff3434";
    ctx.fillRect(x+15,y+15,8,5);
    ctx.fillRect(x+38,y+15,8,5);

    bar(x-10,y-25,80,8,enemy.hp,enemy.maxHp,"#e84b59");
}

function spawnEffect(x,y,color,size=25) {
    effects.push({
        x,y,color,size,
        life:18,
        max:18
    });

    for(let i=0;i<10;i++) {
        particles.push({
            x,y,
            vx:(Math.random()-.5)*7,
            vy:(Math.random()-.5)*7,
            life:25,
            color
        });
    }
}

function drawEffects() {
    effects.forEach(e=>{
        ctx.globalAlpha=e.life/e.max;
        ctx.strokeStyle=e.color;
        ctx.lineWidth=5;

        ctx.beginPath();
        ctx.arc(
            e.x-camera,e.y,
            e.size*(1-e.life/e.max)+10,
            0,Math.PI*2
        );
        ctx.stroke();

        ctx.globalAlpha=1;
    });

    particles.forEach(p=>{
        ctx.globalAlpha=p.life/25;
        ctx.fillStyle=p.color;
        ctx.fillRect(p.x-camera,p.y,5,5);
        ctx.globalAlpha=1;
    });
}

function hitEnemy(damage) {
    if(enemy.hp<=0)return;

    enemy.hp=Math.max(0,enemy.hp-damage);

    spawnEffect(
        enemy.x+30,
        enemy.y+35,
        "#ffd66e",
        30
    );

    shake=7;

    if(enemy.hp<=0) {
        gameOver=true;
        result="승리!";
        message.innerText="🏆 승리! 몬스터를 처치했습니다!";
    }
}

function attack() {
    if(gameOver || player.attackCooldown>0)return;

    player.attackCooldown=22;
    player.attackAnim=12;

    if(CONFIG.name==="마법사") {
        projectiles.push({
            x:player.x+player.facing*45,
            y:player.y+35,
            vx:player.facing*9,
            damage:CONFIG.damage,
            color:"#b68cff",
            size:13
        });
    }

    else if(CONFIG.name==="궁수") {
        projectiles.push({
            x:player.x+player.facing*45,
            y:player.y+32,
            vx:player.facing*12,
            damage:CONFIG.damage,
            color:"#72edb1",
            size:7
        });
    }

    else {
        let distance=Math.abs(
            (enemy.x+30)-(player.x+23)
        );

        if(distance<115) {
            hitEnemy(CONFIG.damage);
        } else {
            spawnEffect(
                player.x+player.facing*65,
                player.y+35,
                "#ffffff",
                25
            );
        }
    }
}

function skill() {
    if(gameOver || player.skillCooldown>0)return;

    player.skillCooldown=240;
    player.skillAnim=35;

    if(CONFIG.name==="전사") {
        let distance=Math.abs(enemy.x-player.x);

        if(distance<230) {
            hitEnemy(CONFIG.skill_damage);
        }

        spawnEffect(
            player.x+25,player.y+40,
            "#ffb34d",100
        );
    }

    else if(CONFIG.name==="마법사") {
        projectiles.push({
            x:player.x+player.facing*40,
            y:player.y+20,
            vx:player.facing*7,
            damage:CONFIG.skill_damage,
            color:"#c58aff",
            size:35
        });
    }

    else {
        for(let i=0;i<5;i++) {
            projectiles.push({
                x:player.x+player.facing*40,
                y:player.y+20+(i-2)*13,
                vx:player.facing*(11-i*.4),
                damage:CONFIG.skill_damage/5,
                color:"#65f0b2",
                size:7
            });
        }
    }

    message.innerText="✨ "+CONFIG.skill+" 발동!";
}

function update(dt) {
    if(gameOver)return;

    frame++;

    let speed=player.speed*dt;

    if(keys["ArrowLeft"]||keys["a"]) {
        player.vx=-speed;
        player.facing=-1;
    }
    else if(keys["ArrowRight"]||keys["d"]) {
        player.vx=speed;
        player.facing=1;
    }
    else {
        player.vx=0;
    }

    player.x+=player.vx;

    if((keys["ArrowUp"]||keys["w"])&&player.grounded) {
        player.vy=-13;
        player.grounded=false;
    }

    player.vy+=.65*dt;
    player.y+=player.vy*dt;

    if(player.y+player.h>=GROUND) {
        player.y=GROUND-player.h;
        player.vy=0;
        player.grounded=true;
    }

    player.x=Math.max(20,Math.min(3000,player.x));

    player.attackCooldown=Math.max(
        0,player.attackCooldown-dt
    );

    player.skillCooldown=Math.max(
        0,player.skillCooldown-dt
    );

    player.invincible=Math.max(
        0,player.invincible-dt
    );

    player.attackAnim=Math.max(
        0,player.attackAnim-dt
    );

    player.skillAnim=Math.max(
        0,player.skillAnim-dt
    );

    // 적 AI
    let dx=player.x-enemy.x;

    if(Math.abs(dx)>60) {
        enemy.x+=Math.sign(dx)*enemy.speed*dt;
    }

    enemy.attackCooldown=Math.max(
        0,enemy.attackCooldown-dt
    );

    enemy.invincible=Math.max(
        0,enemy.invincible-dt
    );

    // 적 공격
    if(Math.abs(dx)<85 && enemy.attackCooldown<=0) {
        enemy.attackCooldown=65;

        if(player.invincible<=0) {
            player.hp=Math.max(
                0,player.hp-20
            );

            player.invincible=45;

            spawnEffect(
                player.x+20,
                player.y+35,
                "#ff5353"
            );

            if(player.hp<=0) {
                gameOver=true;
                result="패배";
                message.innerText="💀 패배! 다시 도전해 보세요.";
            }
        }
    }

    // 투사체
    projectiles.forEach(p=>{
        p.x+=p.vx*dt;

        if(
            Math.abs(p.x-enemy.x-30)<35 &&
            Math.abs(p.y-enemy.y-40)<55 &&
            !p.hit
        ) {
            p.hit=true;
            hitEnemy(p.damage);
        }
    });

    projectiles=projectiles.filter(
        p=>!p.hit&&p.x>-100&&p.x<4000
    );

    // 효과 업데이트
    effects.forEach(e=>e.life-=dt);
    effects=effects.filter(e=>e.life>0);

    particles.forEach(p=>{
        p.x+=p.vx*dt;
        p.y+=p.vy*dt;
        p.life-=dt;
    });

    particles=particles.filter(p=>p.life>0);

    camera=Math.max(
        0,Math.min(player.x-300,2500)
    );

    if(!gameOver && player.skillCooldown<=0) {
        message.innerText="✨ 스킬 사용 가능!";
    }
}

function draw() {
    ctx.save();

    if(shake>0) {
        ctx.translate(
            (Math.random()-.5)*shake,
            (Math.random()-.5)*shake
        );
        shake*=.8;
    }

    drawBackground();

    drawEnemy();
    drawPlayer();

    projectiles.forEach(p=>{
        ctx.fillStyle=p.color;
        ctx.shadowBlur=18;
        ctx.shadowColor=p.color;

        ctx.beginPath();
        ctx.arc(
            p.x-camera,p.y,p.size,
            0,Math.PI*2
        );
        ctx.fill();

        ctx.shadowBlur=0;
    });

    drawEffects();

    ctx.restore();

    // HUD
    bar(20,20,250,18,player.hp,player.maxHp,"#4bdb8c");
    text("PLAYER HP "+Math.ceil(player.hp),20,57,17);

    bar(720,20,250,18,enemy.hp,enemy.maxHp,"#e94b65");
    text("MONSTER HP "+Math.ceil(enemy.hp),720,57,17);

    text(
        "SKILL: "+Math.ceil(player.skillCooldown/60),
        20,95,15,
        player.skillCooldown<=0?"#65efb0":"#ffcf70"
    );

    text("WEAPON: "+CONFIG.weapon,20,120,15);

    if(gameOver) {
        ctx.fillStyle="rgba(0,0,0,.75)";
        ctx.fillRect(0,0,W,H);

        text(result,W/2-80,H/2,45,
            result==="승리!"?"#ffdc70":"#ff6565"
        );

        text("다시 시작 버튼을 눌러주세요",
            W/2-145,H/2+55,20);
    }
}

function loop(timestamp) {
    let dt=lastTime?
        Math.min((timestamp-lastTime)/16.67,2):1;

    lastTime=timestamp;

    update(dt);
    draw();

    requestAnimationFrame(loop);
}

// 키보드
window.addEventListener("keydown",e=>{
    let key=e.key.toLowerCase();

    if(["arrowleft","arrowright","arrowup"," "].includes(key)) {
        e.preventDefault();
    }

    keys[key]=true;

    if(key==="j"&&!attackPressed) {
        attack();
        attackPressed=true;
    }

    if(key==="k"&&!skillPressed) {
        skill();
        skillPressed=true;
    }
});

window.addEventListener("keyup",e=>{
    let key=e.key.toLowerCase();
    keys[key]=false;

    if(key==="j")attackPressed=false;
    if(key==="k")skillPressed=false;
});

function bindButton(id,key) {
    const btn=document.getElementById(id);

    btn.addEventListener("pointerdown",e=>{
        e.preventDefault();
        keys[key]=true;
    });

    ["pointerup","pointerleave","pointercancel"].forEach(event=>{
        btn.addEventListener(event,()=>{
            keys[key]=false;
        });
    });
}

bindButton("left","arrowleft");
bindButton("right","arrowright");
bindButton("jump","arrowup");

document.getElementById("attack").onclick=attack;
document.getElementById("skill").onclick=skill;

document.getElementById("restart").onclick=()=>{
    resetGame();
};

canvas.addEventListener("pointerdown",()=>{
    canvas.focus();
});

resetGame();
requestAnimationFrame(loop);

</script>
</body>
</html>
"""

html = html.replace(
    "__CONFIG__",
    json.dumps(game_data, ensure_ascii=False)
)

components.html(
    html,
    height=680,
    scrolling=False
)

st.caption(
    "MINI BATTLE ARENA | 실시간 2D 횡스크롤 전투 프로토타입"
)
